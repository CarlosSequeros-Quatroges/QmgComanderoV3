<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/transparente"
    android:padding="3dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="5dp"
        app:cardElevation="5dp">

        <LinearLayout
            android:id="@+id/laySel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="3dp">

            <LinearLayout
                android:id="@+id/fondo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/vc_text_minwidth"
                android:background="@color/mesaOcupada"
                android:orientation="vertical">

                <!-- numero de pedido y estado (cuenta pedida) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivMesa"
                        android:layout_width="@dimen/icon_small_size"
                        android:layout_height="@dimen/icon_small_size"
                        android:layout_gravity="left"
                        android:background="@drawable/bar_printer_azul" />

                    <TextView
                        android:id="@+id/numero"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:gravity="left|center_vertical"
                        android:text="1001"
                        android:textColor="@color/textoBlanco"
                        android:textSize="@dimen/text_actionbar"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFechaHora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="5dp"
                        android:gravity="center"
                        android:text="26/11 12:35"
                        android:textColor="@color/textoBlanco"
                        android:textSize="@dimen/text_actionbar"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivEstado"
                        android:layout_width="@dimen/icon_small_size"
                        android:layout_height="@dimen/icon_small_size"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="20dp"
                        android:background="@drawable/bar_tiquet" />
                </LinearLayout>

                <!-- punto de venta web -->
                <TextView
                    android:id="@+id/tvCodptoWeb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:gravity="left"
                    android:text="Entrega: WEB01"
                    android:textColor="@color/textoBlanco"
                    android:textSize="@dimen/text_actionbar"
                    android:textStyle="bold"
                    android:maxLines="2" />

                <!-- forma de pago -->
                <TextView
                    android:id="@+id/tvFpagoWeb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="2dp"
                    android:gravity="left"
                    android:text="Forma de pago: Tarjeta"
                    android:textColor="@color/textoBlanco"
                    android:textSize="@dimen/text_actionbar"
                    android:textStyle="bold"
                    android:maxLines="2" />

                <!-- importe del pedido -->
                <TextView
                    android:id="@+id/importe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="3dp"
                    android:gravity="left"
                    android:text="123.14"
                    android:textColor="@color/textoBlanco"
                    android:textSize="@dimen/text_actionbar"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
