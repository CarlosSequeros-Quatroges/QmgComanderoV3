<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layCons"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cvFondo"
        android:gravity="center_vertical"
        android:orientation="horizontal">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tlTipoMesas"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:background="@color/cvFondo"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/textoAzul"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/textoAzul"
        app:tabTextColor="@android:color/darker_gray">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mesas_strTabMesas" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mesas_strTabPedidos" />
    </com.google.android.material.tabs.TabLayout>

        <!-- hay pedidos web nuevos sin ver (aviso_web = S): icono vibrando, como en el TPV de Windows -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivAvisoPedidos"
            android:layout_width="@dimen/icon_cv_size"
            android:layout_height="@dimen/icon_cv_size"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bar_aviso_sel"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.appcompat.widget.SearchView
        android:id="@+id/svMesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="8dp"
        tools:layout_editor_absoluteY="315dp"
        android:inputType="text"
        android:background="@color/cvFondo"
        android:layout_weight="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/textoAzul"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMesas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginTop="3dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:itemCount="10"
        tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        tools:listitem="@layout/mesas_cardview"
        tools:orientation="vertical"
        tools:spanCount="2"
        android:layout_marginBottom="5dp"
        android:layout_weight="50"
        />


</LinearLayout>


