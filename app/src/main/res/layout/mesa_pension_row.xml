<?xml version="1.0" encoding="utf-8"?>
<!-- fila de pension de una submesa en la tarjeta de mesa: icono verde (se aplica) o rojo (no) y codigo de pension -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="2dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivPensionFila"
        android:layout_width="@dimen/icon_small_size"
        android:layout_height="@dimen/icon_small_size"
        android:layout_gravity="center_vertical"
        android:background="@drawable/pension_si" />

    <TextView
        android:id="@+id/tvPensionFila"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="5dp"
        android:text="MP"
        android:textColor="@color/textoBlanco"
        android:textSize="@dimen/text_actionbar"
        android:textStyle="bold" />

</LinearLayout>
